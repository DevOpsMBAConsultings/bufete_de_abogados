<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_draft" model="case.stage">
            <field name="name">Draft</field>
            <field name="sequence">1</field>
        </record>

        <record id="stage_wip" model="case.stage">
            <field name="name">Work in Progress</field>
            <field name="sequence">10</field>
        </record>

        <record id="stage_done" model="case.stage">
            <field name="name">Done</field>
            <field name="sequence">20</field>
        </record>

        <record id="stage_closed" model="case.stage">
            <field name="name">Closed</field>
            <field name="sequence">30</field>
            <field name="is_closed" eval="True"/>
        </record>
    </data>
</odoo>