<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <!-- Define the tree view for the lawyer model -->
    <record id="view_lawyer_tree" model="ir.ui.view">
        <field name="name">lawyer tree</field>
        <field name="model">lawyer</field>
        <field name="arch" type="xml">
            <list string="Lawyer" sample="1">
                <field name="name" readonly="1" />
                <field name="mobile" readonly="1" />
                <field name="email" readonly="1" />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field name="practice_area_ids" string="Practice Area" widget="many2many_tags"
                    readonly="1" />
            </list>
        </field>
    </record>

    <!-- Define the form view for the lawyer model -->
    <record id="view_lawyer_form" model="ir.ui.view">
        <field name="name">lawyer.form</field>
        <field name="model">lawyer</field>
        <field name="arch" type="xml">
            <form string="Lawyer" class="o_form_full_width">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object"
                            class="oe_stat_button" icon="fa-briefcase">
                            <field name="case_count" widget="statinfo" string="Casos" />
                        </button>
                        <button name="action_view_legal_advice" type="object"
                            class="oe_stat_button" icon="fa-comments">
                            <field name="legal_advice_count" widget="statinfo" string="Legal Advice" />
                        </button>
                    </div>
                    <field name="active" invisible="1" />
                    <field name="image" widget="image" class="oe_avatar"
                        options="{&quot;preview_image&quot;: &quot;image&quot;}" />
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="name" placeholder="Lawyer's Name" required="True"
                                style="font-size: min(4vw, 2.6rem);" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="practice_area_ids" widget="many2many_tags" />
                            <field name="email" widget="email" />
                            <field name="mobile" widget="phone" />
                        </group>
                        <group>
                            <field name="gender" />
                            <field name="birth_date" />
                        </group>
                    </group>
                </sheet>
                <chatter reload_on_follower="True" />
            </form>
        </field>
    </record>


    <!-- defintion kanban view to lawyer -->
    <record id="view_lawyer_kanban" model="ir.ui.view">
        <field name="name">lawyer kanban</field>
        <field name="model">lawyer</field>
        <field name="arch" type="xml">
            <kanban string="Lawyer" class="o_hr_employee_kanban" sample="1">
                <field name="image" />
                <field name="name" />
                <templates>
                    <t t-name="card">
                        <div
                            class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <t>
                                <field name="image" class="o_kanban_image_fill_left d-block"
                                    preview_image="image_128" widget="background_image"
                                    options="{'zoom': true, 'zoom_delay': 1000}" />
                            </t>
                            <div class="o_kanban_record">
                                <div class="o_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" placeholder="Employee's Name" />
                                    </strong>
                                    <div>
                                        <field name="mobile" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_lawyer_search" model="ir.ui.view">
        <field name="name">lawyer search</field>
        <field name="model">lawyer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="mobile" />
                <!-- أضف المزيد من الحقول حسب الحاجة -->
                <filter string="By Name" name="filter_by_name" domain="[('name', '!=', False)]" />
                <filter string="By Mobile" name="filter_by_email" domain="[('mobile', '!=', False)]" />
            </search>
        </field>
    </record>


    <!-- lawyer action -->
    <record id="lawyer_action_view" model="ir.actions.act_window">
        <field name="name">Lawyer</field>
        <field name="res_model">lawyer</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_lawyer_search" />
    </record>
</odoo>