<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Legal Advice Tree View -->
    <record id="view_legal_advice_tree" model="ir.ui.view">
        <field name="name">legal.advice.tree</field>
        <field name="model">legal.advice</field>
        <field name="arch" type="xml">
            <list string="Legal Advice">
                <field name="name" />
                <field name="partner_id" />
                <field name="lawyer_id" />
                <field name="date" />
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                    decoration-success="state == 'converted'"
                    decoration-warning="state == 'confirmed'" />
            </list>
        </field>
    </record>

    <!-- Legal Advice Form View -->
    <record id="view_legal_advice_form" model="ir.ui.view">
        <field name="name">legal.advice.form</field>
        <field name="model">legal.advice</field>
        <field name="arch" type="xml">
            <form string="Legal Advice">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="state != 'draft'" class="oe_highlight" />
                    <button name="action_create_case" string="Create Case" type="object"
                        invisible="state != 'confirmed'" class="oe_highlight" />
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ('draft', 'confirmed')" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,converted" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="lawyer_id" />
                            <field name="practice_area_id" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="fee" />
                            <field name="case_id" invisible="not case_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue Description" name="description">
                            <field name="description" placeholder="Describe the client's issue..." />
                        </page>
                        <page string="Advice Given" name="advice">
                            <field name="advice_given" placeholder="What advice was provided?" />
                        </page>
                        <page string="Servicios" name="services">
                            <field name="service_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" />
                                    <field name="name" />
                                    <field name="quantity" />
                                    <field name="price_unit" />
                                    <field name="subtotal" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Legal Advice Action -->
    <record id="action_legal_advice" model="ir.actions.act_window">
        <field name="name">Legal Advice</field>
        <field name="res_model">legal.advice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first legal advice record!
            </p>
        </field>
    </record>
</odoo>