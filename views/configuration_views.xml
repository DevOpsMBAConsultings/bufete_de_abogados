<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Case Stage Views -->
    <record id="view_case_stage_tree" model="ir.ui.view">
        <field name="name">case.stage.tree</field>
        <field name="model">case.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="is_closed" />
            </list>
        </field>
    </record>

    <record id="action_case_stage" model="ir.actions.act_window">
        <field name="name">Case Stages</field>
        <field name="res_model">case.stage</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Law Court Views -->
    <record id="view_law_court_tree" model="ir.ui.view">
        <field name="name">law.court.tree</field>
        <field name="model">law.court</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="city" />
                <field name="country_id" />
            </list>
        </field>
    </record>

    <record id="view_law_court_form" model="ir.ui.view">
        <field name="name">law.court.form</field>
        <field name="model">law.court</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="city" />
                            <field name="state_id" />
                            <field name="country_id" />
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_law_court" model="ir.actions.act_window">
        <field name="name">Courts</field>
        <field name="res_model">law.court</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Law Judge Views -->
    <record id="view_law_judge_tree" model="ir.ui.view">
        <field name="name">law.judge.tree</field>
        <field name="model">law.judge</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
            </list>
        </field>
    </record>

    <record id="view_law_judge_form" model="ir.ui.view">
        <field name="name">law.judge.form</field>
        <field name="model">law.judge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="practice_area_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <group string="Biography">
                        <field name="bio" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_law_judge" model="ir.actions.act_window">
        <field name="name">Judges</field>
        <field name="res_model">law.judge</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Practice Area Views -->
    <record id="view_practice_area_tree" model="ir.ui.view">
        <field name="name">practice.area.tree</field>
        <field name="model">practice.area</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_practice_area" model="ir.actions.act_window">
        <field name="name">Practice Areas</field>
        <field name="res_model">practice.area</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new practice area
            </p>
        </field>
    </record>

    <!-- Services Action -->
    <record id="action_law_services" model="ir.actions.act_window">
        <field name="name">Servicios</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'service')]</field>
        <field name="context">{'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer servicio legal
            </p>
            <p>
                Aquí puedes gestionar los servicios que ofreces a tus clientes.
            </p>
        </field>
    </record>
</odoo>