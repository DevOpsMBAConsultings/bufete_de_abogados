<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bufete_de_abogados.LawDashboard">
        <div class="o_law_dashboard p-4">
            <div class="o_law_header d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
                <h2 class="mb-0 fw-bold text-dark">Law Management Dashboard</h2>
                <div class="o_law_filters d-flex gap-3">
                    <div class="o_filter_item">
                        <label class="d-block small text-muted mb-1">Lawyer Filter</label>
                        <select class="form-select form-select-sm" t-on-change="onLawyerChange">
                            <option value="">All Lawyers</option>
                            <t t-foreach="state.lawyers" t-as="lawyer" t-key="lawyer.id">
                                <option t-att-value="lawyer.id"><t t-esc="lawyer.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="o_filter_item">
                        <label class="d-block small text-muted mb-1">Date Filter</label>
                        <select class="form-select form-select-sm">
                            <option>Last 7 Days</option>
                            <option>Last 30 Days</option>
                            <option>All Time</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- Advice Section -->
                <div class="col-md-3">
                    <div class="o_dashboard_card card h-100 border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #0099ff 0%, #0066cc 100%);">
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <h1 class="display-4 fw-bold mb-0"><t t-esc="state.stats.advice.total"/></h1>
                            <p class="h5">Total Advice</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="o_dashboard_card card h-100 border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #004d40 0%, #00695c 100%);">
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <h1 class="display-4 fw-bold mb-0"><t t-esc="state.stats.cases.total"/></h1>
                            <p class="h5">Total Cases</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="o_dashboard_card card h-100 border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #00c9a7 0%, #00897b 100%);">
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <h1 class="display-4 fw-bold mb-0"><t t-esc="state.stats.hearings.total"/></h1>
                            <p class="h5">All Hearings</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="o_dashboard_card card h-100 border-0 shadow-sm text-white" style="background: linear-gradient(135deg, #b300cc 0%, #800080 100%);">
                        <div class="card-body text-center d-flex flex-column justify-content-center">
                            <h1 class="display-4 fw-bold mb-0"><t t-esc="state.stats.invoices.total"/></h1>
                            <p class="h5">All Invoices</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Sub Metrics -->
                <div class="col-md-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="card border-0 shadow-sm text-white p-3 text-center" style="background: #0099ff;">
                                <h3 class="fw-bold mb-0"><t t-esc="state.stats.advice.new"/></h3>
                                <p class="small mb-0">New Advice</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card border-0 shadow-sm text-white p-3 text-center" style="background: #0088ee;">
                                <h3 class="fw-bold mb-0"><t t-esc="state.stats.advice.closed"/></h3>
                                <p class="small mb-0">Close Advice</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-white p-3 text-center h-100 justify-content-center" style="background: #125e51;">
                        <h3 class="fw-bold mb-0"><t t-esc="state.stats.cases.won"/></h3>
                        <p class="small mb-0">Won Cases</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="card border-0 shadow-sm text-white p-2 text-center" style="background: #00c9a7;">
                                <h4 class="fw-bold mb-0 small"><t t-esc="state.stats.hearings.new"/></h4>
                                <p style="font-size: 0.7rem;" class="mb-0">New Hearings</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card border-0 shadow-sm text-white p-2 text-center" style="background: #00bfa5;">
                                <h4 class="fw-bold mb-0 small"><t t-esc="state.stats.hearings.open"/></h4>
                                <p style="font-size: 0.7rem;" class="mb-0">Open Hearings</p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card border-0 shadow-sm text-white p-2 text-center" style="background: #00a68d;">
                                <h4 class="fw-bold mb-0 small"><t t-esc="state.stats.hearings.closed"/></h4>
                                <p style="font-size: 0.7rem;" class="mb-0">Close Hearings</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="card border-0 shadow-sm text-white p-3 text-center" style="background: #b300cc;">
                                <h3 class="fw-bold mb-0"><t t-esc="state.stats.invoices.paid"/></h3>
                                <p class="small mb-0">Paid Invoices</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card border-0 shadow-sm text-white p-3 text-center" style="background: #9c27b0;">
                                <h3 class="fw-bold mb-0"><t t-esc="state.stats.invoices.due"/></h3>
                                <p class="small mb-0">Due/Partial</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>